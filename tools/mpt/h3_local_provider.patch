+def _download_videos_h3_local_on_demand(
+    *,
+    task_id: str,
+    search_terms: List[str],
+    video_aspect: VideoAspect,
+    audio_duration: float,
+    max_clip_duration: int,
+    material_directory: str,
+) -> List[str]:
+    """Render local h3 clips until they cover the narration, then stop.
+
+    Same shape as the paid generative loops so the pipeline behaves
+    identically, with two deliberate differences. Nothing is downloaded --
+    ``generate_videos`` already wrote the file -- and a failure on one search
+    term is logged and skipped instead of aborting the run, because no clip
+    costs anything and a partial set still makes a video.
+    """
+    video_paths: List[str] = []
+    material_sources: list[dict[str, Any]] = []
+
+    try:
+        required_duration = float(audio_duration)
+    except (TypeError, ValueError) as exc:
+        raise h3_local.H3LocalError("h3 audio duration must be a finite number") from exc
+    if not math.isfinite(required_duration):
+        raise h3_local.H3LocalError("h3 audio duration must be a finite number")
+    if required_duration <= 0:
+        logger.warning(
+            f"skip h3 generation because required audio duration is not positive: "
+            f"duration={required_duration}"
+        )
+        _persist_material_sources(task_id, material_sources)
+        return video_paths
+
+    try:
+        clip_duration = int(max_clip_duration)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise h3_local.H3LocalError("h3 clip duration must be a positive integer") from exc
+    if clip_duration <= 0:
+        raise h3_local.H3LocalError("h3 clip duration must be a positive integer")
+
+    output_dir = material_directory or utils.storage_dir("cache_videos", create=True)
+    total_duration = 0.0
+    for index, search_term in enumerate(search_terms):
+        try:
+            video_items = h3_local.generate_videos(
+                search_term=search_term,
+                minimum_duration=clip_duration,
+                video_aspect=video_aspect,
+                output_dir=output_dir,
+                # A fixed seed would give every term of every task the same
+                # framing; deriving it from the position keeps runs repeatable
+                # while still varying the shot.
+                seed=42 + index,
+            )
+        except h3_local.H3LocalError as exc:
+            logger.error(f"h3 generation failed for '{search_term}': {exc}")
+            continue
+
+        for item in video_items:
+            if not os.path.exists(item.url) or os.path.getsize(item.url) == 0:
+                logger.error(f"h3 reported a clip that is not on disk: {item.url}")
+                continue
+            logger.info(f"video saved: {item.url}")
+            video_paths.append(item.url)
+            try:
+                material_sources.append(_material_source_record(item, item.url))
+            except Exception as source_error:
+                logger.warning(
+                    "failed to prepare generated material source record: "
+                    f"provider=h3_local, error={type(source_error).__name__}, "
+                    f"detail={source_error}"
+                )
+            total_duration += min(clip_duration, item.duration)
+            if total_duration >= required_duration:
+                break
+        if total_duration >= required_duration:
+            logger.info(
+                "generated h3 materials cover the required duration: "
+                f"generated={total_duration:.1f}s, required={required_duration:.1f}s"
+            )
+            break
+
+    if not video_paths:
+        raise h3_local.H3LocalError(
+            "h3 produced no usable clips for any search term"
+        )
+    logger.success(f"generated {len(video_paths)} local h3 videos")
+    _persist_material_sources(task_id, material_sources)
+    return video_paths
+
+
 def _download_videos_seedance_on_demand(
     *,
     task_id: str,
